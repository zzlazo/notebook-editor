# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/*
# 例外: 採点者がそのまま起動できるよう実行構成のみコミットする。
# 親ディレクトリごと除外すると否定が効かないため、中身を除外する形にしている。
!.vscode/launch.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# FVM Version Cache
.fvm/

.local/

**/.env.*

# 例外: 接続先のホスト名とポートのみを持ち、秘密情報を含まない。
# これが無いと launch.json と flutter run が動かないため、意図的にコミットする。
!.env.local.android
!.env.local.web